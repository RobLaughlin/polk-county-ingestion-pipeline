version: 2

sources:
  - name: raw
    description: "The raw source data ingested from the Polk County Ingestion Pipeline"
    database: __GCP_PROJECT_ID__
    schema: __RAW_DATASET_ID__
    tables:
      - name: __RAW_TABLE_ID__
        # No loaded_at_field, so BigQuery's table last-modified time is used.
        config:
          freshness:
            warn_after: {count: 90, period: day}
      - name: __RAW_LOGS_TABLE_ID__

